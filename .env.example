# ==============================================================================
# Kredensial Autentikasi Instagram (Session Cookies)
# ==============================================================================
# Cara mendapatkan 'sessionid' dan 'csrftoken' dari browser (Hanya butuh 15 detik):
# 1. Buka https://www.instagram.com di browser (Chrome / Edge / Firefox) & login.
# 2. Tekan F12 (Developer Tools) -> Masuk ke tab 'Application' (atau 'Storage').
# 3. Di panel kiri: klik 'Cookies' -> 'https://www.instagram.com'.
# 4. Salin nilai (Value) dari 'sessionid' dan 'csrftoken', lalu tempelkan di bawah ini:

IG_SESSION_ID=your_sessionid_here
IG_CSRF_TOKEN=your_csrftoken_here
IG_DS_USER_ID=your_ds_user_id_here

# ==============================================================================
# Pengaturan Scraping & Anti-Detection
# ==============================================================================
COOKIES_FILE=cookies.json

# Jeda acak antar request (detik) untuk meminimalkan risiko checkpoint/blokir
DELAY_MIN=3.0
DELAY_MAX=6.0

# Proxy (Opsional, format: http://user:pass@host:port atau socks5://host:port)
PROXY=
