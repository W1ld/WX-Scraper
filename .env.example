# ==============================================================================
# Kredensial Autentikasi Twitter / X (Session Cookies)
# ==============================================================================
# Cara mendapatkan 'auth_token' dan 'ct0' dari browser (hanya butuh 15 detik):
# 1. Buka https://x.com di browser (Chrome / Edge / Firefox) & pastikan sudah login.
# 2. Tekan F12 (Developer Tools) -> Masuk ke tab 'Application' (atau 'Storage').
# 3. Di panel kiri: klik 'Cookies' -> 'https://x.com'.
# 4. Salin nilai (Value) dari 'auth_token' dan 'ct0', lalu tempelkan di bawah ini:

AUTH_TOKEN=your_auth_token_here
CT0=your_ct0_here

# ==============================================================================
# Pengaturan Scraping
# =============================================================================
COOKIES_FILE=cookies.json

# delay (second)
DELAY_MIN=3.0
DELAY_MAX=6.0

# Bahasa default antarmuka (id-ID atau en-US)
DEFAULT_LANG=id-ID

PROXY=
